generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  FINANCE
  MANAGER
}

enum ProductType {
  BAHAN_MENTAH
  BARANG_JADI
}

enum OrderStatus {
  DRAFT
  DIPROSES
  SELESAI
  DIKIRIM
  SELESAI_DIKIRIM
  DIBATALKAN
}

enum PaymentStatus {
  BELUM_DIBAYAR
  SEBAGIAN
  LUNAS
}

enum PurchaseStatus {
  DRAFT
  DIPESAN
  DITERIMA
  SELESAI
  DIBATALKAN
}

enum DocumentStatus {
  DRAFT
  AKTIF
  SELESAI
  DIBATALKAN
}

enum LetterType {
  BIASA
  PENTING
  RAHASIA
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  purchases   Purchase[]
  suratJalans SuratJalan[]
  invoices    Invoice[]
  payments    Payment[]
  incoming    IncomingLetter[]
  outgoing    OutgoingLetter[]
  documents   Document[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Product {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  name         String
  type         ProductType
  unit         String
  stock        Decimal     @default(0) @db.Decimal(15, 2)
  minimumStock Decimal     @default(0) @db.Decimal(15, 2)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orderDetails      OrderDetail[]
  purchaseDetails   PurchaseDetail[]
  suratJalanDetails SuratJalanDetail[]
  invoiceDetails    InvoiceDetail[]
}

model Driver {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  licenseNo String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suratJalans SuratJalan[]
}

model Vehicle {
  id          Int      @id @default(autoincrement())
  nomorPolisi String   @unique
  jenis       String
  merek       String?
  model       String?
  warna       String?
  tahun       Int?
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  suratJalans SuratJalan[]
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  customerId  Int
  orderDate   DateTime    @default(now())
  status      OrderStatus @default(DRAFT)
  notes       String?
  total       Decimal     @default(0) @db.Decimal(15, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id])
  details    OrderDetail[]
  suratJalan SuratJalan?
  invoice    Invoice?
  user       User?         @relation(fields: [userId], references: [id])
  userId     Int?
}

model OrderDetail {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Decimal @db.Decimal(15, 2)
  price     Decimal @db.Decimal(15, 2)
  subtotal  Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Purchase {
  id             Int            @id @default(autoincrement())
  purchaseNumber String         @unique
  supplierId     Int
  userId         Int
  purchaseDate   DateTime       @default(now())
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  total          Decimal        @default(0) @db.Decimal(15, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  details  PurchaseDetail[]
}

model PurchaseDetail {
  id         Int     @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Decimal @db.Decimal(15, 2)
  price      Decimal @db.Decimal(15, 2)
  subtotal   Decimal @db.Decimal(15, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model SuratJalan {
  id           Int      @id @default(autoincrement())
  nomorSurat   String   @unique
  orderId      Int      @unique
  userId       Int
  driverId     Int?
  vehicleId    Int?
  tanggalKirim DateTime @default(now())
  tujuan       String?
  penerima     String?
  keterangan   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order   Order              @relation(fields: [orderId], references: [id])
  user    User               @relation(fields: [userId], references: [id])
  driver  Driver?            @relation(fields: [driverId], references: [id])
  vehicle Vehicle?           @relation(fields: [vehicleId], references: [id])
  details SuratJalanDetail[]
}

model SuratJalanDetail {
  id           Int     @id @default(autoincrement())
  suratJalanId Int
  productId    Int
  quantity     Decimal @db.Decimal(15, 2)
  keterangan   String?

  suratJalan SuratJalan @relation(fields: [suratJalanId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

model Invoice {
  id           Int           @id @default(autoincrement())
  nomorInvoice String        @unique
  orderId      Int           @unique
  userId       Int
  tanggal      DateTime      @default(now())
  jatuhTempo   DateTime?
  subtotal     Decimal       @default(0) @db.Decimal(15, 2)
  diskon       Decimal       @default(0) @db.Decimal(15, 2)
  pajak        Decimal       @default(0) @db.Decimal(15, 2)
  total        Decimal       @default(0) @db.Decimal(15, 2)
  statusBayar  PaymentStatus @default(BELUM_DIBAYAR)
  keterangan   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order    Order           @relation(fields: [orderId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  details  InvoiceDetail[]
  payments Payment[]
}

model InvoiceDetail {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Decimal @db.Decimal(15, 2)
  price     Decimal @db.Decimal(15, 2)
  subtotal  Decimal @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id           Int      @id @default(autoincrement())
  invoiceId    Int
  userId       Int
  tanggalBayar DateTime @default(now())
  jumlah       Decimal  @db.Decimal(15, 2)
  metode       String
  keterangan   String?
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model IncomingLetter {
  id            Int        @id @default(autoincrement())
  nomorSurat    String     @unique
  tanggalSurat  DateTime
  tanggalTerima DateTime   @default(now())
  pengirim      String
  perihal       String
  jenis         LetterType @default(BIASA)
  filePath      String?
  keterangan    String?
  userId        Int
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model OutgoingLetter {
  id           Int        @id @default(autoincrement())
  nomorSurat   String     @unique
  tanggalSurat DateTime   @default(now())
  penerima     String
  perihal      String
  jenis        LetterType @default(BIASA)
  filePath     String?
  keterangan   String?
  userId       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Document {
  id           Int            @id @default(autoincrement())
  nomorDokumen String?
  nama         String
  kategori     String
  tanggal      DateTime       @default(now())
  filePath     String?
  status       DocumentStatus @default(DRAFT)
  keterangan   String?
  userId       Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])
}
